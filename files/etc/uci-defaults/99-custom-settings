#!/bin/sh

# 1. 修改默认 LAN 口 IP
uci set network.lan.ipaddr='192.168.100.254'
uci commit network

# 2. 设置 root/admin 密码为 admin123
(echo "admin123"; sleep 1; echo "admin123") | passwd root

# 3. 创建并开启 2GB Swap 文件 (运行在 eMMC 存储上)
SWAP_PATH="/overlay/swapfile"

if [ ! -f "$SWAP_PATH" ]; then
    dd if=/dev/zero of=$SWAP_PATH bs=1M count=2048
    chmod 600 $SWAP_PATH
    mkswap $SWAP_PATH
fi

# 优化内存换页频率，保护 eMMC 寿命
if ! grep -q "vm.swappiness=20" /etc/sysctl.conf; then
    echo "vm.swappiness=20" >> /etc/sysctl.conf
    sysctl -p
fi

# 注册 fstab 自动挂载 Swap
uci add fstab swap
uci set fstab.@swap[-1].device="$SWAP_PATH"
uci set fstab.@swap[-1].enabled='1'
uci commit fstab

swapon $SWAP_PATH

exit 0
